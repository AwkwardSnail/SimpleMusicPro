<Window x:Class="SimpleMusicPro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SimpleMusic Pro" Width="1280" Height="880" MinWidth="820" MinHeight="520"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource GreenBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="15.5"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing" AllowDrop="True" Drop="Window_Drop">
    <DockPanel>
        <!-- The toolbar: files, undo, and the length of the next strum. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,7,8,7">
            <WrapPanel>
                <WrapPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Margin" Value="0,0,4,0" />
                    </Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                        <Setter Property="Margin" Value="0,0,4,0" />
                    </Style>
                </WrapPanel.Resources>
                <Button Content="Open MIDI…" Click="OpenMidi_Click" ToolTip="Start a score from a MIDI file" />
                <Button Content="Open…" Click="Open_Click" ToolTip="Open a SimpleMusic Pro score (Ctrl+O)" />
                <Button Content="Save" Click="Save_Click" ToolTip="Save the score (Ctrl+S)" />
                <Button Content="Save As…" Click="SaveAs_Click" ToolTip="Save the score under a new name (Ctrl+Shift+S)" />
                <Button Content="Export PDF…" Click="ExportPdf_Click" ToolTip="Save the finished score as a PDF" />
                <Border Style="{StaticResource ToolSeparator}" />
                <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)" />
                <Button x:Name="RedoButton" Content="Redo" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)" />
                <Border Style="{StaticResource ToolSeparator}" />
                <TextBlock Text="Strum:" VerticalAlignment="Center" Margin="4,0,6,0" />
                <RadioButton Style="{StaticResource ToolRadio}" GroupName="Length" Tag="16" Content="Whole" Checked="Length_Checked" ToolTip="A strum that lasts the whole bar" />
                <RadioButton Style="{StaticResource ToolRadio}" GroupName="Length" Tag="8" Content="Half" Checked="Length_Checked" ToolTip="A strum of a half note" />
                <RadioButton x:Name="QuarterButton" Style="{StaticResource ToolRadio}" GroupName="Length" Tag="4" Content="Quarter" IsChecked="True" Checked="Length_Checked" ToolTip="A strum of a quarter note" />
                <RadioButton x:Name="EighthButton" Style="{StaticResource ToolRadio}" GroupName="Length" Tag="2" Content="Eighth" Checked="Length_Checked" ToolTip="A strum of an eighth note" />
                <RadioButton Style="{StaticResource ToolRadio}" GroupName="Length" Tag="1" Content="Sixteenth" Checked="Length_Checked" ToolTip="A strum of a sixteenth note, the shortest" />
                <ToggleButton x:Name="DotButton" Content="Dot" Checked="Option_Click" Unchecked="Option_Click" ToolTip="Dotted: half as long again (for an eighth, a quarter or a half)" />
                <ToggleButton x:Name="RestButton" Content="Rest" Checked="Option_Click" Unchecked="Option_Click" ToolTip="Add a rest instead of a strum" />
                <ToggleButton x:Name="AccentButton" Content="Accent" Checked="Option_Click" Unchecked="Option_Click" ToolTip="Add the strum with an accent (&gt;)" />
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,4">
            <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The control panel: the score's name and the staves of the stack. -->
            <Border Grid.Column="0" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Panel" Margin="14,12,14,12" IsEnabled="False">
                        <TextBlock Text="Score" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="Title" Foreground="{StaticResource GreenDimBrush}" />
                        <TextBox x:Name="TitleBox" Margin="0,2,0,8" LostKeyboardFocus="Heading_Changed" />
                        <TextBlock Text="Under the title" Foreground="{StaticResource GreenDimBrush}" />
                        <TextBox x:Name="SubtitleBox" Margin="0,2,0,16" LostKeyboardFocus="Heading_Changed" />

                        <TextBlock Text="Staves, top to bottom" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <CheckBox x:Name="ChordsCheck" Content="Chord diagrams" Margin="0,0,0,12" Click="Stack_Changed" />
                        <CheckBox x:Name="RhythmCheck" Content="Rhythm staff" Margin="0,0,0,4" Click="Stack_Changed" />
                        <TextBlock Text="Name shown at the left" Foreground="{StaticResource GreenDimBrush}" Margin="24,0,0,0" />
                        <TextBox x:Name="RhythmLabelBox" Margin="24,2,0,12" LostKeyboardFocus="Heading_Changed" />
                        <CheckBox x:Name="VoiceCheck" Content="Voice staff (notes)" Margin="0,0,0,4" Click="Stack_Changed" />
                        <TextBlock Text="From the MIDI track" Foreground="{StaticResource GreenDimBrush}" Margin="24,0,0,0" />
                        <ComboBox x:Name="TrackBox" Margin="24,2,0,16" SelectionChanged="Track_Changed" />

                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource GreenDimBrush}" Margin="0,8,0,0">
                            To add a strum, click a note in the voice staff: a + appears above it. Choose a length
                            in the toolbar, then click the +. Click a strum to select it; a length, Dot, Rest or
                            Accent chosen then changes it. Right-click a strum for more, or press Delete.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource GreenDimBrush}" Margin="0,10,0,0">
                            To add a chord, click a note or a strum: a + appears above it in the chord row. Click
                            the + and pick a chord from the list, or type its name to find it. Chords stand at least
                            a quarter note apart. Click a chord to change it; Delete takes it away.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- The preview: the pages as they will print, with the + signs over them. -->
            <ScrollViewer x:Name="PreviewScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="Preview_MouseWheel">
                <Grid>
                    <StackPanel x:Name="Pages" HorizontalAlignment="Center" Margin="24" />
                    <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,120,40,0" TextWrapping="Wrap"
                               Foreground="{StaticResource GreenDimBrush}" TextAlignment="Center"
                               Text="Open a MIDI file to begin (Open MIDI…, or drop the file here)." />
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
